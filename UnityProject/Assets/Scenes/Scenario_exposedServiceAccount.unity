  m_Script: {fileID: 11500000, guid: 4b85a75d92775014496e0f1346a4928b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionManager
  missionName: Exposed Service Account Investigation
  briefing: 'Northstar Technologies has detected suspicious authentication

    activity
    involving an internal service account. Information about

    the account may
    have been unintentionally exposed through publicly

    indexed documents.


    Identify
    the exposed account, then investigate its authentication

    activity on the
    Linux system and determine whether the account was

    successfully accessed.'
  objectives:
  - description: Identify the exposed service account
    type: 4
    target: exposed_service_account
    secondaryTarget: 
    conceptualHint: 'Publicly indexed internal documents may reveal account information.

'
    guidedHint: 'Use CyberSearch operators to narrow results to Northstar documents
      containing service account information.

'
    directHint: 'Search for: site:northstar.test filetype:txt "service account"'
    hintsUsed: 0
    isComplete: 0
  - description: Investigate authentication activity for the exposed account
    type: 5
    target: svc_backup
    secondaryTarget: /var/log/auth.log
    conceptualHint: Authentication logs can be filtered for activity associated with
      a specific account.
    guidedHint: Use grep to search the SSH authentication log for the account discovered
      through CyberSearch.
    directHint: grep svc_backup /var/log/auth.log
    hintsUsed: 0
    isComplete: 0
  scoreManager: {fileID: 1653050651}
