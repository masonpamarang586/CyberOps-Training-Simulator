      m_Calls: []
  m_text: 'site: Restricts search results to a specific domain.

    Example: "site:northstar.test"



    filetype:
    Searches for a specific file type.

    Example:  "filetype:pdf"



    intitle:
    Searches for pages containing a term in the page title.

    Example: "intitle:confidential"



    inurl:
    Searches for pages containing a term in the URL.

    Example: "inurl:documents"



    "exact
    phrase": Searches for an exact phrase.

    Example: "confidential"


    hint:
    Provides a hint to help solve the mission, it allows this search 3 times with
    increasing help per hint used. Hints deduct from points.

    Example: "hint"'
